# SANITIZED EXAMPLE
#
# The original file generated by `nixos-generate-config` contained real disk
# UUIDs and machine-specific storage topology. They were removed before public
# release. Generate a fresh file on the target machine or adapt these labels.
#
# WARNING: the NIXOS_ROOT/NIXOS_BOOT labels below are placeholders.
# If `lsblk -f` does not show these labels, DO NOT try to activate this configuration:
# regenerate this file on the target desktop with `nixos-generate-config`.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  # Labels are placeholders. Either label your filesystems accordingly or,
  # preferably, replace this file with output from `nixos-generate-config`.
  fileSystems."/" = {
    device = "/dev/disk/by-label/NIXOS_ROOT";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-label/NIXOS_BOOT";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode =
    lib.mkDefault config.hardware.enableRedistributableFirmware;
}
